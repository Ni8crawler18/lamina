# Lamina backend — SECRETS & ENVIRONMENT ONLY.
# Public chain config (RPCs, explorers, contract addresses) lives in
# config/chains/*.toml — do NOT put it here.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres (async SQLAlchemy URL). Matches docker-compose (host port 5433).
DATABASE_URL=postgresql+asyncpg://lamina:lamina@localhost:5433/lamina

# One deployer/operator EOA reused across all EVM testnets.
DEPLOYER_PRIVATE_KEY=
OPERATOR_ADDRESS=

# Hedera (non-EVM family) — only needed if hedera-testnet is enabled.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_NETWORK=testnet

# AI agent
ANTHROPIC_API_KEY=

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# MCP server (off by default). Generate strong, distinct tokens, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_ENABLED=false
MCP_ALLOW_WRITES=false
MCP_READ_TOKEN=
MCP_ADMIN_TOKEN=
MCP_ALLOWED_IPS=
MCP_RATE_LIMIT_PER_MIN=60

# Messaging channels (off by default). Telegram bot via @BotFather.
CHANNELS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=     # CSV of allowed chat IDs (leave empty = OPEN, not recommended)

# Optional per-chain private/paid RPC overrides (names referenced in chain TOMLs).
# RPC_URL_ROBINHOOD_TESTNET=
# RPC_URL_ETHEREUM_SEPOLIA=
# RPC_URL_POLYGON_AMOY=
