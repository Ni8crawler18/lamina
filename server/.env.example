# ─── Robinhood Chain / Arbitrum ──────────────────────────────────────────────
# EVM operator wallet (your deployer / treasury address)
OPERATOR_ADDRESS=0xYourWalletAddress
OPERATOR_PRIVATE_KEY=0xYourPrivateKey

# Robinhood Chain testnet RPC
# Option A: Public (rate-limited)
ARBITRUM_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Option B: Alchemy (recommended for production)
# ARBITRUM_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/YOUR_API_KEY

CHAIN_ID=46630

# Contract addresses — fill in after running contracts/scripts/deploy.py
AUDIT_LOG_ADDRESS=
FACTORY_ADDRESS=
USDC_ADDRESS=         # USDC contract on Robinhood Chain testnet (get from faucet/bridge)

# Block explorer
EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# ─── AI Agent ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Server ──────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
